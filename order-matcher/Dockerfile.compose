# syntax=docker/dockerfile:1.7
FROM eclipse-temurin:21-jdk@sha256:ebfbb18d11ff163ee83b21258acf12248af48d22a0fdfdc68fa1a1516c05976a AS build
# Canonical base OS security refresh
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY . .
RUN --mount=type=cache,target=/root/.gradle,sharing=locked \
    chmod +x gradlew && ./gradlew --no-daemon clean bootJar \
 && jar_path="$(ls -1 build/libs/*.jar | grep -v -- '-plain\.jar$' | head -n 1)" \
 && cp "${jar_path}" build/libs/app.jar

FROM eclipse-temurin:21-jre@sha256:0b99b3376fbb50dbf9c0af8535fdd5b8eb0d3fdfc8b1e4967f383b6919f6901a
# Canonical base OS security refresh
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/app
COPY --from=build /app/build/libs/app.jar app.jar
EXPOSE 18110
ENTRYPOINT ["java", "-jar", "/opt/app/app.jar"]

#!/usr/bin/env bash
set -euo pipefail
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
lab_venv="${TRADERX_LAB_VENV:-${HOME}/Library/Caches/traderx-security-lab/venv}"
if [[ "${1:-}" == setup && ! -x "$lab_venv/bin/python" ]]; then
  python3 -c 'import sys,platform; assert sys.version_info[:2] == (3,14) and sys.platform == "darwin" and platform.machine() == "arm64", "Current verified dependency lock requires macOS arm64 / Python 3.14"'
  python3 -m venv "$lab_venv"
fi
if [[ "${1:-}" == setup ]]; then
  "$lab_venv/bin/python" -m pip install --require-hashes -r "$script_dir/requirements-identity.txt"
fi
if [[ -x "$lab_venv/bin/python" ]]; then
  exec "$lab_venv/bin/python" "$script_dir/labctl.py" "$@"
fi
exec python3 "$script_dir/labctl.py" "$@"
